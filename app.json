{
  "expo": {
    "name": "Uruwork",
    "slug": "uruwork",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.uruwork.app"
    },
    "android": {
      "package": "com.uruwork.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "scheme": "uruwork",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6818c07f-b43b-4e15-a530-fa8c10e24a1a"
      }
    },
    "owner": "managerbtu"
  }
}
